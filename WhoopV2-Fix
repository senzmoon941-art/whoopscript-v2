    TabButton.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 4)
    BtnCorner.Parent = TabButton

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Size = UDim2.new(1, -6, 1, -6)
    TabPage.Position = UDim2.new(0, 3, 0, 3)
    TabPage.BackgroundTransparency = 1
    TabPage.BorderSizePixel = 0
    TabPage.Visible = false
    TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabPage.ScrollBarThickness = 3
    TabPage.Parent = ContentArea

    local PageList = Instance.new("UIListLayout")
    PageList.Padding = UDim.new(0, 6)
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Parent = TabPage

    TabButton.MouseButton1Click:Connect(function()
        for _, tabData in pairs(Tabs) do
            tabData.Page.Visible = false
            tabData.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            tabData.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        TabPage.Visible = true
        TabButton.BackgroundColor3 = rgbColor
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    Tabs[tabName] = {Button = TabButton, Page = TabPage, Name = tabName}
    return TabPage
end

