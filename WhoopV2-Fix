-- Optimized Dynamic Rainbow RGB Color Generator (Zero lag tick limiter)
local rgbColor = Color3.new(1, 1, 1)
local lastUpdate = 0
RunService.Heartbeat:Connect(function()
    local t = tick()
    if t - lastUpdate >= 0.05 then
        lastUpdate = t
        local hue = (t % 5) / 5
        rgbColor = Color3.fromHSV(hue, 1, 1)
    end
end)

-- Notification System
local function sendChatNotification(msg)
    pcall(function()
        if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannel = TextChatService.TextChannels.RBXGeneral
            if textChannel then
                textChannel:SendAsync(msg)
            end
        else
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = msg,
                Color = rgbColor,
                Font = Enum.Font.SourceSansBold,
                FontSize = Enum.FontSize.Size18
            })
        end
    end)
end

