local function toggleDupeMode()
    isDupeEnabled = not isDupeEnabled
    if isDupeEnabled then
        DupeToggleBtn.BackgroundColor3 = rgbColor
        DupeToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DupeToggleBtn.Text = "⚔️"
    else
        DupeToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        DupeToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        DupeToggleBtn.Text = "⚡"
    end
    for _, v in pairs(dupeParts) do
        if v and v.Parent then
            v.Transparency = isDupeEnabled and 0.5 or 0
        end
    end
    notifyToggle("WhoopSC Dupe Mode", isDupeEnabled)
end

