local dupeRootPart, dupeHumanoid

local function updateDupeData()
    local c = LocalPlayer.Character
    if c then
        dupeRootPart = c:FindFirstChild("HumanoidRootPart")
        dupeHumanoid = c:FindFirstChildOfClass("Humanoid")
        dupeParts = {}
        for _, v in pairs(c:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency == 0 then
                table.insert(dupeParts, v)
            end
        end
    end
end

